# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Portal Convención Web
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA comitas .env.local ni .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio — usada en metadatos y canonical URLs (cliente + servidor)
NEXT_PUBLIC_SITE_URL=https://explorando-la-convencion-web-eta.vercel.app

# URL del sitio exclusivamente server-side — usada en trustedOrigins de auth.
# Debe coincidir con NEXT_PUBLIC_SITE_URL en producción pero no se expone al cliente.
SITE_URL=https://explorando-la-convencion-web-eta.vercel.app

# ── Better Auth ───────────────────────────────────────────────────────────────
# Secreto de firma de sesiones. Genera uno seguro con: openssl rand -base64 32
# OBLIGATORIO: la app lanza un error de arranque si esta variable no está definida.
BETTER_AUTH_SECRET=replace-with-a-secure-32-char-minimum-secret

# URL base de autenticación (debe coincidir con el dominio en producción)
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Google Search Console ─────────────────────────────────────────────────────
# Token de verificación de propiedad de Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token_here

# ── PostgreSQL / Prisma ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
