# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Portal Convención Web
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA comitas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# -- Auth.js v5 (NextAuth) ----------------------------------------------------
# Obligatorio. Secreto para firmar JWT de sesión.
# Genera uno seguro con: openssl rand -base64 32
AUTH_SECRET=reemplaza-con-secreto-seguro-de-32-caracteres-minimo

# URL canónica de tu app (usada por Auth.js para construir callbacks OAuth)
NEXTAUTH_URL=http://localhost:3000

# -- Google OAuth (https://console.cloud.google.com) --------------------------
# 1. Crear proyecto → APIs & Services → Credentials → OAuth 2.0 Client ID
# 2. Authorized redirect URI: https://tu-dominio.com/api/auth/callback/google
AUTH_GOOGLE_ID=tu_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=tu_client_secret

# -- Apple OAuth (https://developer.apple.com) --------------------------------
# Requiere Apple Developer Account ($99/año)
# 1. Certificates, Identifiers & Profiles → Services IDs
# 2. Authorized return URL: https://tu-dominio.com/api/auth/callback/apple
AUTH_APPLE_ID=com.tu-dominio.web
AUTH_APPLE_SECRET=-----BEGIN PRIVATE KEY-----
# ... (Private Key en formato PEM, una línea por línea en producción)
# -----END PRIVATE KEY-----

# -- Sitio (metadatos SEO y canonical URLs) -----------------------------------
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
SITE_URL=https://tu-dominio.com

# -- Google Search Console (opcional) ----------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=tu_token_de_verificacion
